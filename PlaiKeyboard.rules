
(rules PCB PlaiKeyboard.dsn
  (snap_angle 
    fortyfive_degree
  )
  (rule
    (width 200.0)
    (clearance 200.0)
    (clearance 100.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 200.0 (type "kicad_default"))
  )
  (padstack "Via[0-1]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_600:300_um" "Via[0-1]_600:300_um" default
  )
  (via 
    "Via[0-1]_600:300_um-kicad_default" "Via[0-1]_600:300_um" "kicad_default"
  )
  (via_rule
    default "Via[0-1]_600:300_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_600:300_um-kicad_default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    COL13 "Net-(D28-A)" ROW4 "Net-(D58-A)" COL1 "Net-(D16-A)" ROW1 "Net-(D23-A)"
    ROW3 "Net-(D47-A)" COL4 "Net-(D5-A)" COL3 "Net-(D18-A)" COL6 "Net-(D75-A)"
    COL8 "Net-(D64-A)" "Net-(D44-A)" "Net-(D49-A)" ROW5 "Net-(D76-A)" COL11 "Net-(D26-A)"
    "Net-(D32-A)" "Net-(D67-A)" ROW0 "Net-(D8-A)" COL12 "Net-(D68-A)" "Net-(D59-A)" COL0
    "Net-(D15-A)" "Net-(D65-A)" ROW2 "Net-(D30-A)" "Net-(D74-A)" COL9 "Net-(D62-A)" "Net-(D29-A)"
    COL2 "Net-(D45-A)" COL5 "Net-(D20-A)" "Net-(D38-A)" COL10 "Net-(D66-A)" "Net-(D72-A)"
    "Net-(D61-A)" "Net-(D54-A)" "Net-(D39-A)" "Net-(D11-A)" "Net-(D42-A)" "Net-(D21-A)" "Net-(D71-A)" "Net-(D17-A)"
    COL7 "Net-(D22-A)" "Net-(D7-A)" "Net-(D40-A)" "Net-(D63-A)" "Net-(D19-A)" "Net-(D27-A)" "Net-(D14-A)"
    "Net-(D36-A)" "Net-(D25-A)" "Net-(D52-A)" "Net-(D55-A)" "Net-(D51-A)" "A_20" "B_21" GND
    "S1_22" "Net-(D48-A)" "Net-(D37-A)" "Net-(D13-A)" "Net-(D35-A)" "Net-(D33-A)" "Net-(D1-A)" "Net-(D6-A)"
    "Net-(D57-A)" "Net-(D9-A)" "Net-(D3-A)" "Net-(D12-A)" "Net-(D46-A)" "Net-(D31-A)" "Net-(D53-A)" "Net-(D2-A)"
    "Net-(D60-A)" "unconnected-(A1-RUN-Pad30)" "unconnected-(A1-GPIO26_ADC0-Pad31)" "unconnected-(A1-GPIO27_ADC1-Pad32)" "unconnected-(A1-AGND-Pad33)" "unconnected-(A1-GPIO28_ADC2-Pad34)" "unconnected-(A1-ADC_VREF-Pad35)" "unconnected-(A1-3V3-Pad36)"
    "unconnected-(A1-3V3_EN-Pad37)" "unconnected-(A1-VSYS-Pad39)" "unconnected-(A1-VBUS-Pad40)" "Net-(D43-A)" "Net-(D34-A)" "Net-(D4-A)" "Net-(D56-A)" "Net-(D77-A)"
    "Net-(D10-A)" "Net-(D73-A)" "Net-(D50-A)" "Net-(D24-A)" "Net-(D69-A)" "Net-(D70-A)" "Net-(D41-A)"
    (clearance_class "kicad_default")
