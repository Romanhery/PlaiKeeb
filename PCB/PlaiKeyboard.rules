
(rules PCB PlaiKeyboard.dsn
  (snap_angle 
    fortyfive_degree
  )
  (rule
    (width 200.0)
    (clearance 200.0)
    (clearance 100.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 200.0 (type "kicad_default"))
  )
  (padstack "Via[0-1]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_600:300_um" "Via[0-1]_600:300_um" default
  )
  (via 
    "Via[0-1]_600:300_um-kicad_default" "Via[0-1]_600:300_um" "kicad_default"
  )
  (via_rule
    default "Via[0-1]_600:300_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_600:300_um-kicad_default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    COL9 "Net-(D54-A)" COL13 "Net-(D28-A)" COL4 "Net-(D63-A)" COL1 "Net-(D46-A)"
    "Net-(D31-A)" COL10 "Net-(D69-A)" COL14 "Net-(D44-A)" COL5 "Net-(D78-A)" COL12
    "Net-(D42-A)" COL2 "Net-(D32-A)" "Net-(D68-A)" COL3 "Net-(D62-A)" COL7 "Net-(D80-A)"
    COL8 "Net-(D38-A)" "Net-(D48-A)" COL0 "Net-(D45-A)" COL6 "Net-(D65-A)" COL11
    "Net-(D41-A)" "V_BAT" GND "Net-(D82-A)" "Net-(D50-A)" "Net-(D57-A)" "Net-(D51-A)" "Net-(D59-A)"
    "Net-(D77-A)" "Net-(D66-A)" "EC_A" "EC_B" "Net-(D83-A)" "Net-(D37-A)" "Net-(D22-A)" "Net-(D67-A)"
    "Net-(D27-A)" "Net-(D23-A)" "Net-(D40-A)" "Net-(D72-A)" "SR_CLOCK" "SR_DATA" "SR_LATCH" ROW0
    ROW1 ROW2 ROW3 ROW4 "/VBAT_SW" "unconnected-(U1-RST-Pad15)" +3V3 ROW5
    "Net-(D81-A)" "Net-(D29-A)" "Net-(D24-A)" "Net-(D4-A)" "Net-(D9-A)" "Net-(D15-A)" "Net-(D25-A)" "Net-(D30-A)"
    "Net-(D18-A)" "Net-(D74-A)" "Net-(D76-A)" "Net-(D56-A)" "Net-(D17-A)" "Net-(D13-A)" "Net-(D1-A)" "Net-(D52-A)"
    "Net-(D75-A)" "Net-(D71-A)" "unconnected-(U2-QF-Pad5)" "unconnected-(U2-QG-Pad6)" "unconnected-(U2-QH-Pad7)" "unconnected-(U2-QH'-Pad9)" "Net-(D3-A)" "Net-(D64-A)"
    "Net-(D53-A)" "Net-(D20-A)" "Net-(D49-A)" "Net-(D6-A)" "Net-(D7-A)" "Net-(D19-A)" "Net-(D70-A)" "Net-(D2-A)"
    "Net-(D26-A)" "Net-(D36-A)" "Net-(D34-A)" "Net-(D43-A)" "Net-(D58-A)" "Net-(D35-A)" "Net-(D12-A)" "Net-(D5-A)"
    "Net-(D47-A)" "Net-(D39-A)" "Net-(D33-A)" "Net-(D61-A)" "Net-(D73-A)" "Net-(D14-A)" "Net-(D79-A)" "Net-(D60-A)"
    "Net-(D10-A)" "Net-(D21-A)" "Net-(D55-A)" "Net-(D11-A)" "Net-(D8-A)" "Net-(D16-A)"
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)